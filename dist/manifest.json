{
	"_version": "1.9.0",
	"sap.app": {
		"id": "com.westernacher.collaborationPortal.core",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"resources": "resources.json",
		"dataSources": {
			"mainService": {
				"uri": "/sap/opu/odata/sap/ZWCP_HOME_SRV/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0",
					"localUri": "localService/metadata.xml"
				}
			},
			"TM_COLL_FAGRFQ_SRV": {
				"uri": "/sap/opu/odata/sap/TM_COLL_FAGRFQ_SRV/",
				"type": "OData",
				"settings": {
					"localUri": "localService/TM_COLL_FAGRFQ_SRV/metadata.xml"
				}
			}
		},
		"sourceTemplate": {
			"id": "servicecatalog.connectivityComponentForManifest",
			"version": "0.0.0"
		}
	},
	"sap.ui": {
		"fullWidth": true,
		"technology": "UI5",
		"icons": {
			"icon": "sap-icon://task",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"resourceRoots": {
			"com.westernacher.collaborationPortal.quotation": "./modules/quotation",
			"com.westernacher.collaborationPortal.confirmation": "./modules/confirmation",
			"com.westernacher.collaborationPortal.fosExecution": "./modules/execution",
			"com.westernacher.collaborationPortal.invoicesubmission": "./modules/invoicesubmission",
			"com.westernacher.collaborationPortal.invoices": "./modules/invoices",
			"com.westernacher.collaborationPortal.freightUnit": "./modules/freightUnit",
			"com.westernacher.collaborationPortal.freightBooking": "./modules/freightBooking"
		},
		"rootView": {
			"viewName": "com.westernacher.collaborationPortal.core.view.App",
			"type": "XML",
			"async": true,
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.71.0",
			"libs": {
				"sap.f": {},
				"sap.m": {},
				"sap.ui.core": {},
				"sap.viz": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.westernacher.collaborationPortal.core.i18n.i18n"
				}
			},
			"i18nhome": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.westernacher.collaborationPortal.core.i18n.i18n"
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true
			},
			"_RFQAWARDEDRATIO": {
				"uri": "/sap/opu/odata/sap/ZWCP_C_RFQAWARDEDRATIO_CDS",
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"odataVersion": "2.0",
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				}
			},
			"_CONFPICKUPDUE": {
				"uri": "/sap/opu/odata/sap/ZWCP_C_CONFPICKUPDUE_CDS",
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"odataVersion": "2.0",
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				}
			},
			"_RFQQUOTEDUE": {
				"uri": "/sap/opu/odata/sap/ZWCP_C_RFQQUOTEDUE_CDS",
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"odataVersion": "2.0",
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				}
			},
			"_MD": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": true
			},
			"_DV": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": true,
				"uri": "model/HomeRoleVisualsConfig.json"
			},
			"FreightAgreementRFQ": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "TM_COLL_FAGRFQ_SRV",
				"preload": true
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"viewPath": "com.westernacher.collaborationPortal.core.view",
				"controlId": "app",
				"controlAggregation": "pages",
				"clearControlAggregation": true,
				"async": true
			},
			"routes": [
				{
					"pattern": "FreightOrderQuotation/{UserRole}",
					"name": "QUOTE",
					"target": [
						{
							"name": "QUOTE",
							"prefix": "q"
						}
					]
				},
				{
					"pattern": "FreightOrderConfirmation/{UserRole}",
					"name": "CONFIRMATION",
					"target": [
						{
							"name": "CONFIRMATION",
							"prefix": "c"
						}
					]
				},
				{
					"pattern": "FreightOrderExecution/{UserRole}",
					"name": "EXECUTION",
					"target": [
						{
							"name": "EXECUTION",
							"prefix": "e"
						}
					]
				},
				{
					"pattern": "FreightOrderSettlement/{UserRole}",
					"name": "INVOICE_SUBMISSION",
					"target": [
						{
							"name": "INVOICE_SUBMISSION",
							"prefix": "is"
						}
					]
				},
				{
					"pattern": "Invoices/{UserRole}",
					"name": "INVOICE",
					"target": [
						{
							"name": "INVOICE",
							"prefix": "i"
						}
					]
				},
				{
					"pattern": "FU/{UserRole}",
					"name": "FU",
					"target": [
						{
							"name": "FU",
							"prefix": "fu"
						}
					]
				},
				{
					"pattern": "FB/{UserRole}",
					"name": "FB",
					"target": [
						{
							"name": "FB",
							"prefix": "fb"
						}
					]
				},
				{
					"pattern": "",
					"name": "home",
					"target": "home"
				}
			],
			"targets": {
				"home": {
					"viewName": "Home",
					"viewId": "home",
					"viewLevel": 1,
					"title": "{i18n>worklistViewTitle}"
				},
				"CONFIRMATION": {
					"type": "Component",
					"name": "com.westernacher.collaborationPortal.confirmation",
					"containerOptions": {
						"propagateModel": false,
						"height": "100%",
						"manifest": true
					}
				},
				"EXECUTION": {
					"type": "Component",
					"name": "com.westernacher.collaborationPortal.fosExecution",
					"containerOptions": {
						"propagateModel": false,
						"height": "100%",
						"manifest": true
					}
				},
				"QUOTE": {
					"type": "Component",
					"name": "com.westernacher.collaborationPortal.quotation",
					"containerOptions": {
						"propagateModel": false,
						"height": "100%",
						"manifest": true
					}
				},
				"INVOICE_SUBMISSION": {
					"type": "Component",
					"name": "com.westernacher.collaborationPortal.invoicesubmission",
					"containerOptions": {
						"propagateModel": false,
						"height": "100%",
						"manifest": true
					}
				},
				"INVOICE": {
					"type": "Component",
					"name": "com.westernacher.collaborationPortal.invoices",
					"containerOptions": {
						"propagateModel": false,
						"height": "100%",
						"manifest": true
					}
				},
				"FU": {
					"type": "Component",
					"name": "com.westernacher.collaborationPortal.freightUnit",
					"containerOptions": {
						"propagateModel": false,
						"height": "100%",
						"manifest": true
					}
				},
				"FB": {
					"type": "Component",
					"name": "com.westernacher.collaborationPortal.freightBooking",
					"containerOptions": {
						"propagateModel": false,
						"height": "100%",
						"manifest": true
					}
				},
				"objectNotFound": {
					"viewName": "ObjectNotFound",
					"viewId": "objectNotFound"
				},
				"notFound": {
					"viewName": "NotFound",
					"viewId": "notFound"
				}
			}
		}
	},
	"sap.platform.hcp": {
		"uri": "webapp",
		"_version": "1.1.0"
	},
	"sap.platform.abap": {
		"uri": "/sap/bc/ui5_ui5/sap/zwcp_portal/webapp",
		"_version": "1.1.0"
	}
}