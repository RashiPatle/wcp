<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:f="sap.ui.layout.form" xmlns:smartField="sap.ui.comp.smartfield">
	<Dialog title="{i18nhome>UpdateFreightUnitTitle}" afterClose="afterCloseUpdateFreightUnitDialog">
		<content>
			<f:SimpleForm id="idUpdateFreightOrderId" editable="false" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
				labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
				singleContainerFullSize="false">
				<f:content>
					<!--{SrcCarrierConfimedDate/#@sap:label}-->
					<Label text="{i18nhome>LoadReadyDate}"/>
					<!--dateValue="{path:'SrcCarrierConfimedDate'}"-->
					<DateTimePicker id="idUFULoadReadyDate" dateValue="{path:'LoadReadyDate'}"/>
					<!--<Label text="{to_Items/TranspOrdItemQuantity/#@sap:label}"/>-->
					<!--<Input id="idEditQuantity" value="{path:'TranspOrdItemQuantity', formatter: '.formatter.onFormatQuantity'}"-->
					<!--	description="{TranspOrdItemQuantityUnit}"></Input>-->
					<Label text="{i18nhome>LoadWeight}"/>
					<Input id="idEditFUWeight"
						value="{parts : [ 'LoadWeight', 'TranspOrdGrossWeightUnit' ], formatter:'.coreFormatter.customNumberUnitOnlyNumber'}"
						description="{TranspOrdGrossWeightUnit}" change="formattingAmountsInLocale"></Input>
					<Label text="{i18nhome>LoadQuantity}"/>
					<Input id="idEditFUVolume"
						value="{parts : [ 'LoadQuantity', 'TranspOrdGrossVolumeUnit' ], formatter:'.coreFormatter.customNumberUnitOnlyNumber'}"
						description="{TranspOrdGrossVolumeUnit}" change="formattingAmountsInLocale"></Input>
					<smartField:SmartLabel labelFor="idEditFUMOT"/>
					<smartField:SmartField id="idEditFUMOT" value="{LoadEquipmentType}"/>
					<smartField:SmartLabel labelFor="idEditFUSCAC"/>
					<smartField:SmartField id="idEditFUSCAC" value="{SCAC}"/>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button text="{i18nhome>Cancel}" press="onUpdateFreightUnitCancel"/>
		</beginButton>
		<endButton>
			<Button text="{i18nhome>OK}" press="onUpdateFreightUnitConfirmed"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>