			<!--</f:SimpleForm>-->
			<VBox class="sapUiSmallMargin">
				<Label labelFor="idUnitForDistRBG" text="Unit for Distances:"/>
				<RadioButtonGroup id="idUnitForDistRBG" columns="1" class="sapUiMediumMarginBottom">
					<RadioButton id="idUFDKM" text="Kilometer" selected="{= ${_MD>/DefaultUnitForDistSet} === 'KM' ? true: false}" groupName="UnitForDistance"/>
					<RadioButton id="idUFDMI" text="Mile" selected="{= ${_MD>/DefaultUnitForDistSet} === 'MI' ? true: false}" groupName="UnitForDistance"/>
				</RadioButtonGroup>
				<Label labelFor="idTimeZoneInput" text="User Time Zone:"/>
				<Input id="idTimeZoneInput" type="Text" width="100px" fieldWidth="60%" maxLength="3" class="sapUiSmallMarginBottom" liveChange="onTimeZoneInputLiveChange"/>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>Cancel}" press="onChangeSettingCancel"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>OK}" press="onChangeSettingConfirm"/>
		</endButton>
