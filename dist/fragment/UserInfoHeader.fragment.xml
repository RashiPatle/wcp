<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f">
	<VBox height="100%">
		<VBox justifyContent="SpaceBetween">
			<layoutData>
				<FlexItemData growFactor="1" shrinkFactor="0"/>
			</layoutData>
			<Title text="{i18n>UserInfo}" wrapping="true" class="sapUiSmallMarginEnd sapUiSmallMarginTop">
				<layoutData>
					<FlexItemData alignSelf="End"/>
				</layoutData>
			</Title>
			<HBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
				<f:Avatar displaySize="L"></f:Avatar>
				<VBox justifyContent="End" class="sapUiSmallMarginBegin">
					<Title text="{_MD>/UserInfo/BusinessPartnerFullName}" wrapping="true"/>
					<Label text="{i18n>Role}: {_MD>/UserInfo/CurrentBusinessPartnerRoleShortName}" wrapping="true" class="sapUiTinyMarginBottom"/>
				</VBox>
			</HBox>
			<OverflowToolbar design="Solid">
				<Button icon="sap-icon://action-settings" type="Transparent" text="{i18n>Setting}" press="onEditSettingPress"/>
				<ToolbarSpacer/>
				<Button icon="sap-icon://edit" type="Transparent" text="{i18n>ChangeRole}" press="onEditRolePress"/>
			</OverflowToolbar>
		</VBox>
	</VBox>
</core:FragmentDefinition>