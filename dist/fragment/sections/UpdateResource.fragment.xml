<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:f="sap.ui.layout.form" xmlns:smartField="sap.ui.comp.smartfield">
	<Dialog title="{i18nhome>UpdateResource}" afterClose="afterCloseUpdateResourceDialog" resizable="true" horizontalScrolling="false">
		<content>
			<f:SimpleForm id="idUpdateFreightOrderId" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
				labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
				singleContainerFullSize="false">
				<f:content>
					<!--{i18nhome>PlateNumber}-->
					<Label text="{to_Items/PlateNumber/#@sap:label}" labelFor="idPlateNumber"/>
					<Input id="idPlateNumber" value="{PlateNumber}"/>
					<smartField:SmartLabel labelFor="idCountry"/>
					<smartField:SmartField id="idCountry" value="{Country}" innerControlsCreated="onInnerControlsCreated"/>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button text="{i18nhome>Cancel}" press="onUpdateResourceCancel"/>
		</beginButton>
		<endButton>
			<Button text="{i18nhome>OK}" press="onUpdateResourceConfirmed"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>