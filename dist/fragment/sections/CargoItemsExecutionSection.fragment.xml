<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:t="sap.ui.table" xmlns:f="sap.ui.layout.form">
	<t:TreeTable id="idCargoTreeTable" rows="{path: 'CargoTreeModel>/', parameters : { countMode: 'Inline',numberOfExpandedLevels: 2 }}"
		selectionMode="None" ariaLabelledBy="title" enableColumnFreeze="true" fixedColumnCount="1">
		<t:extension>
			<!-- Toolbar containing the button to submit the changes -->
			<OverflowToolbar>
				<Title id="title" text="{i18n>CargoItems}"/>
				<ToolbarSpacer/>
				<OverflowToolbarButton id="idCargoSubmitButton" tooltip="{i18n>SubmitChanges}" type="Transparent" icon="sap-icon://compare-2"
					press="onPressCargoItemSubmit" visible="{= ${_AM>/ZWCP_C_ExecCargoItems} ? ${_AM>/ZWCP_C_ExecCargoItems/updatable} : false }"
					enabled="{_AM>/E_AEditItem}"/>
			</OverflowToolbar>
		</t:extension>
		<t:columns>
			<!-- Columns with the template aggregation binding (Widths mentioned for each column to get the horizontal scrollbar) -->
			<t:Column width="25rem">
				<Label text="{to_Stops/LocationId/#@sap:label}"/>
				<t:template>
					<Text text="{CargoTreeModel>Location}"/>
				</t:template>
			</t:Column>
			<t:Column width="12rem">
				<Label text="{to_Stops/SrceStopPlannedDateTimeF/#@sap:label}"/>
				<t:template>
					<Text text="{CargoTreeModel>StartDateTime}"/>
				</t:template>
			</t:Column>
			<t:Column width="12rem">
				<Label text="{to_Stops/DestStopPlannedDateTimeF/#@sap:label}"/>
				<t:template>
					<Text text="{CargoTreeModel>EndDateTime}"/>
				</t:template>
			</t:Column>
			<t:Column width="8rem">
				<Label text="{i18n>Activity}"/>
				<t:template>
					<HBox visible="{= ${CargoTreeModel>CargoItem} ? true : false }">
						<items>
							<core:Icon src="{= ${CargoTreeModel>Type} === 'Load' ? 'sap-icon://download' : 'sap-icon://upload' }"
								tooltip="{= ${CargoTreeModel>Type} === 'Load' ? ${i18n>Load} : ${i18n>Unload}}" color="#8875E7"></core:Icon>
							<Label design="Bold" text="{CargoTreeModel>CargoItem}" class="sapUiTinyMarginBegin"/>
						</items>
					</HBox>
				</t:template>
			</t:Column>
			<t:Column width="4rem" hAlign="Center">
				<Label text="{to_Stops/to_CargoLoad/TranspOrdItemIsDangerousGood/#@sap:label}" wrapping="true"/>
				<t:template>
					<VBox visible="{= ${CargoTreeModel>CargoItem} ? true : false }" alignItems="Center" alignContent="Center">
						<items>
							<core:Icon src="sap-icon://warning2" color="Negative" visible="{= ${CargoTreeModel>IsDangerous} ? true : false }"></core:Icon>
						</items>
					</VBox>
				</t:template>
			</t:Column>
			<t:Column width="7rem">
				<Label text="{to_Stops/to_CargoLoad/TranspOrdItemGrossWeight/#@sap:label}"/>
				<t:template>
					<ObjectNumber
						number="{ parts:[{path:'CargoTreeModel>GrossWeight'},{path:'CargoTreeModel>WeightUnit'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
						unit="{CargoTreeModel>WeightUnit}"/>
				</t:template>
			</t:Column>
			<t:Column width="7rem">
				<Label text="{to_Stops/to_CargoLoad/TranspOrdItemGrossVolume/#@sap:label}"/>
				<t:template>
					<ObjectNumber
						number="{ parts:[{path:'CargoTreeModel>GrossVolume'},{path:'CargoTreeModel>VolumeUnit'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
						unit="{CargoTreeModel>VolumeUnit}"/>
				</t:template>
			</t:Column>
			<t:Column width="6rem">
				<Label text="{to_Stops/to_CargoLoad/TranspOrdItemQuantity/#@sap:label}"/>
				<t:template>
					<ObjectNumber
						number="{ parts:[{path:'CargoTreeModel>Quantity'},{path:'CargoTreeModel>QuantityUnit'}], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"
						unit="{CargoTreeModel>QuantityUnit}"/>
				</t:template>
			</t:Column>
			<t:Column width="8rem" visible="{= ${_AM>/ZWCP_C_ExecCargoItems} ? true : false }">
				<Label text="{to_Stops/to_CargoLoad/ActualLoadingQuantity/#@sap:label}"/>
				<t:template>
					<HBox>
						<items>
							<Input value="{CargoTreeModel>ActualQuantity}" type="Number" visible="{= ${CargoTreeModel>CargoItem} ? true : false }"/>
							<!-- The visibility for the uom in actual quantity has to be toggled based on wether it is being displayed for the child and not on the parent-->
							<Title text="{CargoTreeModel>QuantityUnit}" class="sapUiTinyMarginBegin sapUiTinyMarginTop"
								visible="{= ${CargoTreeModel>CargoItem} ? true : false }"/>
						</items>
					</HBox>
				</t:template>
			</t:Column>
		</t:columns>
	</t:TreeTable>
</core:FragmentDefinition>