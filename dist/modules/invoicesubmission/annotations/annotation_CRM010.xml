                ================================================================================-->
			<Annotations Target="SETLEMENT.ZWCP_C_SETLFreightOrdersType">
				<!-- Properties that should be available in the request atleast fields in the worklist smart table -->
				<Annotation Term="UI.PresentationVariant">
					<Record Type="UI.PresentationVariantType">
						<PropertyValue Property="RequestAtLeast">
							<Collection>
								<PropertyPath>TransportationOrder</PropertyPath>
								<PropertyPath>InvoicingStatusCode</PropertyPath>
								<PropertyPath>TransportationOrderUUID</PropertyPath>
								<PropertyPath>CarrierUUID</PropertyPath>
								<PropertyPath>TotalDistanceUnit</PropertyPath>
								<PropertyPath>TranspOrdGrossWeightUnit</PropertyPath>
								<PropertyPath>TranspOrdGrossVolumeUnit</PropertyPath>
								<PropertyPath>TotalAmountCurrency</PropertyPath>
								<PropertyPath>AcceptInvoiceFC</PropertyPath>
								<!-- (Newly added for $Select issue_ total amt will show 0 if this field is not there in $select) -->
								<PropertyPath>total_amount_int</PropertyPath>
							</Collection>
						</PropertyValue>
					</Record>
				</Annotation>
				<Annotation Term="UI.LineItem">
					<Collection>
						<!--===============================================================================
                            Collection of fields to be displayed in the worklist smart table
                            ================================================================================-->
						<!-- CarrierInvoicingStatus -->
						<Annotations Target="SETLEMENT.ZWCP_C_SETLFreightOrdersType/CarrierInvoicingStatus">
							<Annotation Term="com.sap.vocabularies.UI.v1.Hidden"/>
						</Annotations>
						<!-- Transportation Order -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="TransportationOrder"/>
						</Record>
						<!-- Source Location -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="SourceLocationName"/>
						</Record>
						<!-- Destination Location -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="DestinationLocationName"/>
						</Record>
						<!-- Total Amount -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Low"/>
							<PropertyValue Property="Value" Path="TotalAmount"/>
						</Record>
						<!-- Gross Weight -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Low"/>
							<PropertyValue Property="Value" Path="TranspOrdGrossWeight"/>
						</Record>
						<!-- Gross Volume -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Low"/>
							<PropertyValue Property="Value" Path="TranspOrdGrossVolume"/>
						</Record>
						<!-- Total Distance -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Low"/>
							<PropertyValue Property="Value" Path="TotalDistance"/>
						</Record>
					</Collection>
				</Annotation>
				<Annotation Term="UI.SelectionFields">
					<Collection>
						<PropertyPath>TransportationOrder</PropertyPath>
					</Collection>
				</Annotation>
				<Annotation Term="com.sap.vocabularies.UI.v1.DataPoint" Qualifier="TotalAmount">
					<Record Type="com.sap.vocabularies.UI.v1.DataPointType">
						<PropertyValue Property="Value" Path="TotalAmount"/>
						<PropertyValue Property="NumberFormat">
							<Record>
								<PropertyValue Property="ScaleFactor" Int="0"/>
								<PropertyValue Property="NumberOfFractionalDigits" Int="3"/>
							</Record>
						</PropertyValue>
					</Record>
				</Annotation>
			</Annotations>
