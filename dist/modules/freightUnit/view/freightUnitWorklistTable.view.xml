									<!--	customData:property="TranspOrdLifeCycleStatus"/>-->
								</items>
								<layoutData>
									<OverflowToolbarLayoutData priority="Low" shrinkable="true"/>
								</layoutData>
							</SegmentedButton>
						</FlexBox>
						<Select id="idToolbarFilters" change="onSelectingQuickFilter" selectedKey="InConfirmation" visible="{device>/system/phone}">
							<core:ListItem text="{i18n>allBtn}" key="All"></core:ListItem>
							<core:ListItem icon="sap-icon://pending" text="{i18n>inConfirmationBtn}" key="InConfirmation" customData:status="01,10"
								customData:property="TranspOrdLifeCycleStatus"></core:ListItem>
							<core:ListItem icon="sap-icon://accept" text="{i18n>confirmedBtn}" key="Confirmed" customData:status="04"
								customData:property="TranspOrdLifeCycleStatus"></core:ListItem>
							<layoutData>
								<OverflowToolbarLayoutData shrinkable="true" priority="High"/>
							</layoutData>
						</Select>
					</OverflowToolbar>
				</smartTable:customToolbar>
				<Table mode="MultiSelect" sticky="HeaderToolbar,ColumnHeaders" selectionChange="onTabeSelectionChange" itemPress="onTableItemPress"
					growing="true" growingThreshold="10" updateFinished="onTableUpdateFinished">
					<headerToolbar>
						<OverflowToolbar>
							<Button press="onRefreshList" icon="sap-icon://synchronize" text="{i18nhome>refreshBtn}" tooltip="{i18nhome>refreshBtn}">
