				<smartTable:customToolbar>
					<OverflowToolbar>
						<ToolbarSeparator></ToolbarSeparator>
						<FlexBox visible="{= !${device>/system/phone} }">
							<SegmentedButton id="idSegmentedFilter" width="40%" selectionChange="onSelectingQuickFilter" selectedKey="InConfirmation">
								<items>
									<SegmentedButtonItem id="idAll" width="5em" text="{i18n>allBtn}" key="All"/>
									<SegmentedButtonItem id="idInConfirmation" icon="sap-icon://pending" text="Filter 1" key="InConfirmation"
										customData:status="01,10" customData:property="TranspOrdLifeCycleStatus"/>
