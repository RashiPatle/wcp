								<!--	color="{path:'TranspOrdLifeCycleStatus', formatter:'.formatter.formatFreightOrderStatusIconColor'}"/>-->
								<core:Icon src="{path:'DangerousGoods', formatter:'.coreFormatter.formatDGCustomIcon'}" color="Negative" tooltip="{i18n>dangerousGoods}"/>
								<!--<ObjectNumber number="{parts : [ 'TotalDistance', 'TotalDistanceUnit' ], formatter:'.coreFormatter.customNumberUnitOnlyNumber'}" unit="{TotalDistanceUnit}"/>-->
								<ObjectNumber number="{parts : [ 'LoadWeight', 'TranspOrdGrossWeightUnit' ], formatter:'.coreFormatter.customNumberUnitOnlyNumber'}" unit="{TranspOrdGrossWeightUnit}"/>
