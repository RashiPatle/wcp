			</Annotations>
			<!--TranspOrd GrossWeight Unit -->
			<Annotations Target="FB.FreightBooking/TranspOrdGrossWeightUnit">
				<Annotation Term="com.sap.vocabularies.UI.v1.Hidden"/>
			</Annotations>
			<!--TranspOrd GrossVolume Unit -->
			<Annotations Target="FB.FreightBooking/TranspOrdGrossVolumeUnit">
				<Annotation Term="com.sap.vocabularies.UI.v1.Hidden"/>
			</Annotations>
			<!--TransportationOrder UUID -->
			<Annotations Target="FB.FreightBooking/TransportationOrderUUID">
				<Annotation Term="com.sap.vocabularies.UI.v1.Hidden"/>
			</Annotations>
			<!--UpdateFC -->
			<Annotations Target="FB.FreightBooking/UpdateFC">
				<Annotation Term="com.sap.vocabularies.UI.v1.Hidden"/>
			</Annotations>
		</Schema>
