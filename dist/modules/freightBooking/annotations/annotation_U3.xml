	<edmx:DataServices>
		<Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="ZWCP_FB_SRV">
			<!--===============================================================================
                Entity Type from chosen collection 
               https://ha6.wup.services:5101/sap/opu/odata/sap/ZWCP_FB_U6/FreightBookings?$expand=to_Items&$format=json

                ================================================================================-->
			<Annotations Target="FB.FreightBooking">
				<!-- Properties that should be available in the request atleast fields in the worklist smart table -->
				<Annotation Term="UI.PresentationVariant">
					<Record Type="UI.PresentationVariantType">
						<PropertyValue Property="RequestAtLeast">
							<Collection>
								<PropertyPath>FreightBookingID</PropertyPath>
								<PropertyPath>TransportationOrderUUID</PropertyPath>
								<PropertyPath>UpdateFC</PropertyPath>
							</Collection>
						</PropertyValue>
					</Record>
				</Annotation>
				<!--===============================================================================
                Collection of fields to be displayed in the worklist smart table
                ================================================================================-->
				<Annotation Term="UI.LineItem">
					<Collection>
						<!-- Freight Booking Document No. -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="FreightBookingID"/>
						</Record>
						<!-- Shipper Name -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="ShipperFullName"/>
						</Record>
						<!-- Consignee Name-->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="ConsigneeFullName"/>
						</Record>
						<!-- Ocean Booking No -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="PartnerReferenceNumber"/>
						</Record>
						<!-- Master BOL -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="CarrierMasterBoLNumber"/>
						</Record>
						<!-- Voyage -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="TranspOrdItemVoyage"/>
						</Record>
						<!-- Vessel -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="TranspOrdItemVessel"/>
						</Record>
						<!-- Port of Loading -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="PortOfLoadingFullName"/>
						</Record>
						<!-- Sailing Date of Vessel -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="PortOfLoadingPlanningDate"/>
						</Record>
						<!--Expected  Arrival Date -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="PortofDischargePlanningDate"/>
						</Record>
						<!-- Carrier -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="CarrierFullName"/>
						</Record>
						<!-- Dangerous Goods -->
						<!--<Record Type="UI.DataField">-->
						<!--	<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>-->
						<!--	<PropertyValue Property="Value" Path="DangerousGoods"/>-->
						<!--</Record>-->
						<!-- Port of Discharge -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="PortofDischargeFullName"/>
						</Record>
						<!-- Delivery Location -->
						<Record Type="UI.DataField">
							<Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
							<PropertyValue Property="Value" Path="DeliveryStopFullName"/>
						</Record>
					</Collection>
				</Annotation>
				<Annotation Term="UI.SelectionFields">
					<Collection>
						<PropertyPath>FreightBookingID</PropertyPath>
						<PropertyPath>PartnerReferenceNumber</PropertyPath>
						<PropertyPath>CarrierMasterBoLNumber</PropertyPath>
					</Collection>
				</Annotation>
			</Annotations>
			<!--===============================================================================
                Annotations to add search help for filters
	        ================================================================================-->
			<!--TranspOrdItemGrossVolumeUnit-->
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="FB.Item/TranspOrdItemGrossVolumeUnit">
				<Annotation Term="Common.ValueList">
					<Record>
						<PropertyValue Property="Label" String="Gross Volume Unit"/>
						<PropertyValue Property="CollectionPath" String="ZWCP_I_VolumeUoMVH"/>
						<PropertyValue Property="SearchSupported" Bool="false"/>
						<PropertyValue Property="Parameters">
							<Collection>
								<Record Type="Common.ValueListParameterInOut">
									<PropertyValue Property="LocalDataProperty" PropertyPath="TranspOrdItemGrossVolumeUnit"/>
									<PropertyValue Property="ValueListProperty" String="UnitOfMeasure"/>
								</Record>
								<Record Type="Common.ValueListParameterDisplayOnly">
									<PropertyValue Property="ValueListProperty" String="UnitOfMeasure_Text"/>
								</Record>
							</Collection>
						</PropertyValue>
					</Record>
				</Annotation>
			</Annotations>
			<!--TranspOrdItemGrossWeightUnit-->
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="FB.Item/TranspOrdItemGrossWeightUnit">
				<Annotation Term="Common.ValueList">
					<Record>
						<PropertyValue Property="Label" String="Gross Weight Unit"/>
						<PropertyValue Property="CollectionPath" String="ZWCP_I_WeightUoMVH"/>
						<PropertyValue Property="SearchSupported" Bool="false"/>
						<PropertyValue Property="Parameters">
							<Collection>
								<Record Type="Common.ValueListParameterInOut">
									<PropertyValue Property="LocalDataProperty" PropertyPath="TranspOrdItemGrossWeightUnit"/>
									<PropertyValue Property="ValueListProperty" String="UnitOfMeasure"/>
								</Record>
								<Record Type="Common.ValueListParameterDisplayOnly">
									<PropertyValue Property="ValueListProperty" String="UnitOfMeasure_Text"/>
								</Record>
							</Collection>
						</PropertyValue>
					</Record>
				</Annotation>
			</Annotations>
			<!--===============================================================================
                Annotations to remove extra fields from the Worklist personalization
                ================================================================================-->
			<Annotations Target="FB.FreightBooking/TransportationOrderTypeDesc">
				<Annotation Term="com.sap.vocabularies.UI.v1.Hidden"/>
			</Annotations>
			<Annotations Target="FB.FreightBooking/TransportationModeDesc">
