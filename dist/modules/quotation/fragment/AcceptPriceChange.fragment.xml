<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18n>AcceptPriceChange}" afterClose="afterCloseUpdateFreightOrderDialog">
		<content>
			<f:SimpleForm id="idAcceptPriceChangeDialog" editable="false" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
				labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
				singleContainerFullSize="false">
				<f:content>
					<!--{i18n>Price}-->
					<Label text="{TndrgStepAbsolutePriceLimit/#@sap:label}"/>
					<Input id="idTendPriceChange" description="{TenderingPreferredCurrency}"
						value="{parts : [ 'TndrgStepAbsolutePriceLimit', 'TenderingPreferredCurrency' ], formatter:'.coreFormatter.customNumberUnitOnlyNumber'}"
						change="onAceeptPriceChange"/>
						<!--{path:'TndrgStepAbsolutePriceLimit'}-->
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button text="{i18n>Cancel}" press="onAcceptPriceChangeCancel"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>OK}" press="onAcceptNewPrice"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>