		<Table id="modulesList"  width="auto" items="{ path : '_MD>/CurrentModules'}" itemPress="onModuleItemPress">
			<columns>
				<Column hAlign="Begin" minScreenWidth="Small"></Column>
				<Column width="30%" vAlign="Middle"></Column>
				<Column minScreenWidth="Phone" demandPopin="true"></Column>
				<Column minScreenWidth="Phone" demandPopin="true"></Column>
				<Column minScreenWidth="Phone" demandPopin="true"></Column>
			</columns>
			<items>
				<ColumnListItem type="Navigation">
					<cells>
						<core:Icon size="2rem" src="{_MD>TileIcon}" tooltip="{_MD>ModuleText}" color="Default" class="sapUiSmallMarginBegin"/>
						<Label class="sapUiSmallMarginBegin" text="{_MD>ModuleText}" wrapping="true"/>
						<Text text=""/>
						<!--<NumericContent withMargin="false" value="" nullifyValue="false"></NumericContent>
							<NumericContent withMargin="false" value="" nullifyValue="false"></NumericContent>-->
						<NumericContent withMargin="false" value="{_MD>ModuleCount}" nullifyValue="false" tooltip="{_MD>CountLabel}: {_MD>ModuleCount}"></NumericContent>
						<Text text="{_MD>CountLabel}"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</l:Grid>
