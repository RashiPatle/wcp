<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:f="sap.ui.layout.form">
	<Dialog title="{i18nhome>UpdateFreightOrderTitle}" afterClose="afterCloseUpdateFreightOrderDialog">
		<content>
			<f:SimpleForm id="idUpdateFreightOrderId" editable="false" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
				labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
				singleContainerFullSize="false">
				<f:content>
					<!--{i18n>ChangedTotalDistance}-->
					<Label text="{_oMainService>/#ZWCP_C_SETLFreightOrdersType/ChangedTotalDistance/@sap:label}"/>
					<!--type="Number"-->
					<Input id="idFOUpdateChangedTotalDistance"
						value="{parts : [ 'ChangedTotalDistance', 'TotalDistanceUnit' ], formatter:'.coreFormatter.customUnitForDistanceOnlyNumber'}"
						description="{path:'TotalDistanceUnit', formatter:'.coreFormatter.customUnitForDistanceOnlyUnit'}" enabled="{DistanceChangeAllowed}"
						change="formattingAmountsInLocale"/>
					<!--{i18n>ChangedTotalVolume}-->
					<Label text="{_oMainService>/#ZWCP_C_SETLFreightOrdersType/ChangedGrossVolumeValue/@sap:label}"/>
					<Input id="idFOUpdateChangedGrossVolume"
						value="{parts : [ 'ChangedGrossVolumeValue', 'TranspOrdGrossVolumeUnit' ], formatter:'.coreFormatter.customNumberUnitOnlyNumber'}"
						description="{TranspOrdGrossVolumeUnit}" enabled="{GrossVolumeChangeAllowed}" change="formattingAmountsInLocale"/>
					<!--{i18n>ChangedGrossWeight}-->
					<Label text="{_oMainService>/#ZWCP_C_SETLFreightOrdersType/ChangedGrossWeight/@sap:label}"/>
					<Input id="idFOUpdateChangedGrossWeight"
						value="{parts : [ 'ChangedGrossWeight', 'TranspOrdGrossWeightUnit' ], formatter:'.coreFormatter.customNumberUnitOnlyNumber'}"
						description="{TranspOrdGrossWeightUnit}" enabled="{GrossWeightChangeAllowed}" change="formattingAmountsInLocale"/>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button text="{i18nhome>Cancel}" press="onUpdateFreightOrderCancel"/>
		</beginButton>
		<endButton>
			<Button text="{i18nhome>OK}" press="onUpdateFreightOrderConfirmed"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>