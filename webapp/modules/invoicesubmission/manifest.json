{
	"_version": "1.12.0",
	"sap.app": {
		"id": "com.westernacher.collaborationportal.invoicesubmission",
		"type": "component",
		"i18n": "i18n/i18n.properties",
		"title": "",
		"description": "",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"embeddedBy": "../"
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": [
			"sap_belize_hcw",
			"sap_belize_hcb",
			"sap_belize",
			"sap_belize_plus"
		]
	},
	"sap.ui5": {
		"resourceRoots": {
			"com.westernacher.collaborationportal.invoicesubmission": "./"
		},
		"autoPrefixId": true,
		"dependencies": {
			"minUI5Version": "1.48.3",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.uxap": {},
				"sap.ui.unified": {},
				"sap.ui.layout": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.westernacher.collaborationportal.core.modules.invoicesubmission.i18n.i18n"
				}
			},
			"i18nhome": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.westernacher.collaborationportal.core.i18n.i18n"
				}
			},
			"_CI": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": true,
				"settings": {
					"defaultBindingMode": "OneWay"
				}
			},
			"_AM": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": true,
				"uri": "model/ControlManagementModel.json"
			},
			"_MD": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": true
			},
			"_SD": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": true
			},
			"_DV": {
				"type": "sap.ui.model.json.JSONModel",
				"preload": true,
				"uri": "model/ChargeColumnsVisibility.json"
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"rootView": {
			"viewName": "com.westernacher.collaborationportal.invoicesubmission.view.InvoiceSubmissionApp",
			"id": "rootViewOfFOsINvoiceSubmssionComponent",
			"type": "XML",
			"async": true
		},
		"routing": {
			"routes": [{
				"pattern": "",
				"name": "master",
				"target": "master"

			}, {
				"pattern": "CreateInvoice/{invoiceId}",
				"name": "createInvoice",
				"target": "createInvoice"

			}],
			"targets": {
				"master": {
					"viewId": "masterView",
					"viewName": "InvoiceSubmissionTable",
					"clearAggregation": true

				},
				"createInvoice": {
					"viewId": "createInvoice",
					"viewName": "CreateInvoice",
					"clearAggregation": true
				}
			},
			"config": {
				"routerClass": "sap.f.routing.Router",
				"async": true,
				"viewType": "XML",
				"viewPath": "com.westernacher.collaborationportal.invoicesubmission.view",
				"controlId": "idAppControlInvoiceSubmission",
				"controlAggregation": "pages"
			}
		},
		"resources": {
			"css": [{
				"uri": "css/style.css"
			}]
		}
	}
}