<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:u="sap.ui.unified" xmlns="sap.m" xmlns:t="sap.ui.table" xmlns:f="sap.f"
	xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form"
	xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
	controllerName="com.westernacher.collaborationPortal.freightBooking.controller.freightBookingObjectPage"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<f:DynamicPage preserveHeaderStateOnScroll="false" headerExpanded="true" class="sapUiNoContentPadding" showNavButton="true"
		navButtonPress="onNavBack">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<!--{i18n>FONumberLabel}-->
					<Title text="{FreightBookingID/#@sap:label}: {FreightBookingID}" wrapping="true"/>
				</f:heading>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{i18nhome>Details}">
						<Link text="{i18n>homeLink}" press="onHomeLinkPress"/>
						<Link text="{i18n>freightBookingList}" press="onPressBack"/>
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:actions>
					<!--enabled="{_AM>/E_AUpdateFU}"-->
					<Button icon="sap-icon://edit" id="edit" text="{i18n>Update}" visible="{_AM>/V_AUpdateFU}" enabled="{_AM>/E_AUpdateFU}"
						press="onUpdateFBPress" type="Transparent"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<layout:Grid hSpacing="1" defaultSpan="L4 M12 S12">
					<layout:content>
						<form:SimpleForm editable="false" layout="ResponsiveGridLayout" title="{i18n>generalInfoOP}" labelSpanXL="4" labelSpanL="4" width="100%"
							labelSpanM="5" labelSpanS="5" adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="0" columnsXL="1"
							columnsL="1" columnsM="1" singleContainerFullSize="false">
							<form:content>
								<!--{i18n>TransportationModeDesc}-->
								<Label text="{TransportationModeDesc/#@sap:label}"/>
								<Text text="{TransportationModeDesc}"/>
								<Label text="{IncotermsClassification/#@sap:label}"/>
								<Text text="{IncotermsClassification} ({IncotermsClassificationName})"/>
								<Label text="{IncotermLocationText/#@sap:label}"/>
								<Text text="{IncotermLocationText}"/>
							</form:content>
						</form:SimpleForm>
						<form:SimpleForm editable="false" layout="ResponsiveGridLayout" title="{i18n>pickupInfoOP}" labelSpanXL="4" labelSpanL="4" width="100%"
							labelSpanM="5" labelSpanS="5" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="1"
							columnsL="1" columnsM="1" singleContainerFullSize="true">
							<form:content>
								<Label text="{ShipperFullName/#@sap:label}"/>
								<Text text="{ShipperFullName}"/>
								<Label text="{PortOfLoadingFullName/#@sap:label}"/>
								<Text text="{PortOfLoadingFullName}"/>
								<Label text="{PortOfLoadingPlanningDate/#@sap:label}"/>
								<Text text="{path:'PortOfLoadingPlanningDate', type:'sap.ui.model.odata.type.DateTime'}"/>
							</form:content>
						</form:SimpleForm>
						<form:SimpleForm editable="false" layout="ResponsiveGridLayout" title="{i18n>deliveryInfoOP}" labelSpanXL="4" labelSpanL="4" width="100%"
							labelSpanM="5" labelSpanS="5" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="1"
							columnsL="1" columnsM="1" singleContainerFullSize="true">
							<form:content>
								<!--{i18n>Consignee}-->
								<Label text="{ConsigneeFullName/#@sap:label}"/>
								<Text text="{ConsigneeFullName}"/>
								<!--{i18n>DeliveryLocation}-->
								<Label text="{PortofDischargeFullName/#@sap:label}"/>
								<Text text="{PortofDischargeFullName}"/>
								<Label text="{PortofDischargePlanningDate/#@sap:label}"/>
								<Text text="{path:'PortofDischargePlanningDate', type:'sap.ui.model.odata.type.DateTime'}"/>
							</form:content>
						</form:SimpleForm>
					</layout:content>
				</layout:Grid>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<layout:Grid class="sapUiSmallMarginTop" hSpacing="2" defaultSpan="L12 M12 S12">
				<layout:content>
					<VBox>
						<core:Fragment fragmentName="com.westernacher.collaborationPortal.core.fragment.sections.ContainerSection" type="XML"/>
						<core:Fragment fragmentName="com.westernacher.collaborationPortal.core.fragment.sections.AttachmentsSection" type="XML"/>
					</VBox>
				</layout:content>
			</layout:Grid>
		</f:content>
	</f:DynamicPage>
</mvc:View>